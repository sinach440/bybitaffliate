# Server (production webhook)
NODE_ENV=development
SERVER_URL=
WEBHOOK_PATH=/telegram-webhook

# Telegram
TELEGRAM_BOT_TOKEN=

# Bybit
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_BASE_URL=https://api.bybit.com

# Affiliate & VIP
AFFILIATE_LINK=https://your-affiliate-link
VIP_GROUP_LINK=https://t.me/your_vip_group

# Requirements & giveaway (restart the bot after changing)
MIN_DEPOSIT_USDT=10
# 0 = no trading volume requirement
MIN_TRADE_VOLUME_USDT=0
# Rewards list in /start, one per line separated by | (overrides GIVEAWAY_PRIZES)
REWARDS=Top referral gets an HP laptop|Top 20 referrals with at least 10 referrals gets $10 each
# Comma-separated; leave empty to hide the giveaway line
GIVEAWAY_PRIZES=cash,iPhone
